# Coinbase Advanced Trade API
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_CHAT_ID_2=                         # optional second recipient

# Twelve Data (required for Gold/XAU/USD signals)
# Get your free API key at: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Bybit Testnet (paper trading) — get keys at https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=your_bybit_testnet_api_key_here
BYBIT_TESTNET_API_SECRET=your_bybit_testnet_api_secret_here
# BYBIT_TRADE_SIZE_USDT=10

# Optional: override defaults
# POLL_INTERVAL_MS=300000
# SWING_COOLDOWN_MS=14400000
# SCALP_COOLDOWN_MS=3600000
